{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../../", 
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "./lib",
    "rootDir": "./src",
    "allowJs": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["packages/backend/src/*"],  // Псевдонім для бекенду
      "@shared/*": ["packages/*"]
    }
  },
  "include": ["packages/**/*"],
  "exclude": ["node_modules"]
}
