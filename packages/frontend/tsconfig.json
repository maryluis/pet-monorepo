{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../../",
    "lib": ["dom", "esnext"],
    "outDir": "./dist",
    "module": "ESNext",
    "esModuleInterop": true,
    "target": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["packages/frontend/src/*"],
      "@shared/*": ["packages/*"]
    }
  },
  "include": ["src/*"],
  "exclude": ["node_modules", "lib", "**/*.spec.tsx", "**/*.test.tsx"]
}
